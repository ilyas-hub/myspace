# Environment variables required by the MySpace demo.
# Copy to .env.local for local development and set the same values in
# Vercel -> Project -> Settings -> Environment Variables.

# MongoDB Atlas M0 connection string (db: myspace).
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/myspace

# Admin gate secret for the edit surface. Any non-empty string; keep secret.
ADMIN_SECRET=

# For @vercel/blob. Generate in Vercel dashboard:
# Project -> Storage -> Blob -> 'Copy Snippet'.
BLOB_READ_WRITE_TOKEN=

# For AI subtitle/summary suggestions (later ticket). Google AI Studio key.
GEMINI_API_KEY=